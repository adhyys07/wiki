---
export interface Props {
  action: string;
  submitLabel: string;
  slugPrefix?: string;
  showAuthor?: boolean;
  hidden?: Record<string, string>;
  values?: {
    title?: string;
    description?: string;
    categories?: string[];
    tags?: string[];
    body?: string;
    author_name?: string;
    author_contact?: string;
  };
  categoryNames?: string[];
}

const {
  action,
  submitLabel,
  slugPrefix = "/wiki/c/",
  showAuthor = true,
  hidden = {},
  values = {},
  categoryNames = [],
} = Astro.props;
---

<form
  id="submit-form"
  class="cform"
  data-action={action}
  data-prefix={slugPrefix}
>
  {
    Object.entries(hidden).map(([k, v]) => (
      <input type="hidden" name={k} value={v} />
    ))
  }

  <p class="cfield cfield--hp" aria-hidden="true">
    <label for="website">Leave this empty</label>
    <input
      id="website"
      name="website"
      type="text"
      tabindex="-1"
      autocomplete="off"
    />
  </p>

  <div class="cfield">
    <label for="title">Page title</label>
    <input
      id="title"
      name="title"
      type="text"
      required
      maxlength="120"
      value={values.title ?? ""}
      placeholder="Running a Hackathon"
    />
    <small>URL: <code id="slug-preview">{slugPrefix}…</code></small>
  </div>

  <div class="cfield">
    <label for="description">One-line description</label>
    <input
      id="description"
      name="description"
      type="text"
      maxlength="300"
      value={values.description ?? ""}
      placeholder="What this page covers, in a sentence."
    />
  </div>

  <div class="crow">
    <div class="cfield">
      <label for="categories">Categories</label>
      <input
        id="categories"
        name="categories"
        type="text"
        list="cat-list"
        value={(values.categories ?? []).join(", ")}
        placeholder="Events, Clubs"
      />
      <datalist id="cat-list">
        {categoryNames.map((c) => <option value={c} />)}
      </datalist>
      <small>Comma-separated.</small>
    </div>
    <div class="cfield">
      <label for="tags">Tags</label>
      <input
        id="tags"
        name="tags"
        type="text"
        value={(values.tags ?? []).join(", ")}
        placeholder="hackathon, funding"
      />
      <small>Comma-separated.</small>
    </div>
  </div>

  <div id="dupe-warn" class="dupe" hidden>
    <strong>Similar pages already exist</strong>
    <ul id="dupe-list"></ul>
    <small>Consider improving one of those instead of starting over.</small>
  </div>

  <div class="cfield">
    <label for="body">The page</label>
    <textarea id="body" name="body" rows="18" required
      >{values.body ?? ""}</textarea
    >
    <input type="hidden" name="paste_ratio" id="paste-ratio" value="0" />
    <div class="uploadrow">
      <label class="uploadbtn">
        <input
          id="image-input"
          type="file"
          accept="image/png,image/jpeg,image/gif,image/webp"
          hidden
        />
        Add an image
      </label>
      <span id="upload-msg"></span>
    </div>
    <small>
      Markdown. <code>[[Page Name]]</code> links to another wiki page.
    </small>
  </div>

  {
    showAuthor && (
      <div class="crow">
        <div class="cfield">
          <label for="author_name">Your name</label>
          <input
            id="author_name"
            name="author_name"
            type="text"
            maxlength="80"
            value={values.author_name ?? ""}
            placeholder="So we can credit you"
          />
        </div>
        <div class="cfield">
          <label for="author_contact">Slack handle or email</label>
          <input
            id="author_contact"
            name="author_contact"
            type="text"
            maxlength="160"
            value={values.author_contact ?? ""}
            placeholder="@you — only if you want a reply"
          />
        </div>
      </div>
    )
  }

  <div class="cactions">
    <button type="submit" id="submit-btn">{submitLabel}</button>
    <span id="form-msg" role="status" aria-live="polite"></span>
  </div>
</form>

<section class="cpreview" aria-label="Preview">
  <h2>Preview</h2>
  <article class="wiki-prose" id="preview-out">
    <p class="cpreview-empty">Start typing and your page appears here.</p>
  </article>
</section>

<style>
  .cform {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .crow {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
  }
  .cfield {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .cfield--hp {
    position: absolute;
    left: -9999px;
  }

  .cfield label {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .cfield small {
    font-size: 0.75rem;
    color: var(--muted);
  }
  .cfield small code {
    font-family: var(--font-mono);
    color: var(--red);
  }

  .cform input,
  .cform textarea {
    font: inherit;
    background: var(--elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 0.6rem 0.8rem;
    color: var(--text);
    width: 100%;
  }
  .cform textarea {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.7;
    resize: vertical;
  }
  .cform input:focus,
  .cform textarea:focus {
    border-color: var(--red);
    outline: none;
  }

  .cactions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .cactions button {
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    background: var(--red);
    color: #fff;
    border: 0;
    border-radius: 999px;
    padding: 0.7rem 1.6rem;
  }
  .cactions button[disabled] {
    opacity: 0.55;
    cursor: progress;
  }

  #form-msg {
    font-size: 0.875rem;
  }
  #form-msg[data-kind="error"] {
    color: var(--red);
  }

  .cpreview {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .cpreview h2 {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1rem;
  }
  .dupe {
    background: color-mix(in srgb, var(--yellow) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--yellow) 40%, transparent);
    border-radius: var(--radius-md);
    padding: 0.8rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.875rem;
  }
  .dupe strong {
    color: var(--yellow);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .dupe ul {
    margin: 0;
    padding-left: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .dupe small {
    color: var(--muted);
  }

  .uploadrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.4rem;
  }
  .uploadbtn {
    cursor: pointer;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-secondary);
    background: var(--elevated);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.35rem 0.9rem;
    letter-spacing: 0;
    text-transform: none;
  }
  .uploadbtn:hover {
    border-color: var(--red);
    color: var(--red);
  }
  #upload-msg {
    font-size: 0.78rem;
    color: var(--muted);
  }
  #upload-msg[data-kind="error"] {
    color: var(--red);
  }

  .cpreview-empty {
    color: var(--muted);
    font-style: italic;
  }
</style>

<script>
  const form = document.getElementById("submit-form") as HTMLFormElement;
  const action = form.dataset.action!;
  const prefix = form.dataset.prefix!;
  const title = document.getElementById("title") as HTMLInputElement;
  const body = document.getElementById("body") as HTMLTextAreaElement;
  const slugOut = document.getElementById("slug-preview")!;
  const out = document.getElementById("preview-out")!;
  const msg = document.getElementById("form-msg")!;
  const btn = document.getElementById("submit-btn") as HTMLButtonElement;

  if (!body.value.trim()) {
    body.placeholder =
      "# Heading\n\nMarkdown works. Link other pages with [[Sprig]].";
  }

  const slugify = (s: string) =>
    s
      .toLowerCase()
      .trim()
      .replace(/[^a-z0-9\s-]/g, "")
      .replace(/\s+/g, "-")
      .replace(/-+/g, "-")
      .replace(/^-|-$/g, "")
      .slice(0, 80);

  const syncSlug = () => {
    slugOut.textContent = `${prefix}${slugify(title.value) || "…"}`;
  };
  title.addEventListener("input", syncSlug);
  syncSlug();

  // Preview goes through the server so it matches what publishes exactly.
  let timer: number | undefined;
  const renderPreview = () => {
    window.clearTimeout(timer);
    timer = window.setTimeout(async () => {
      if (!body.value.trim()) {
        out.innerHTML =
          '<p class="cpreview-empty">Start typing and your page appears here.</p>';
        return;
      }
      const res = await fetch("/api/preview", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ body: body.value }),
      });
      out.innerHTML = (await res.json()).html;
    }, 350);
  };
  body.addEventListener("input", renderPreview);
  if (body.value.trim()) renderPreview();

  /* ---- duplicate detection ---------------------------------------- */
  const dupeWarn = document.getElementById("dupe-warn")!;
  const dupeList = document.getElementById("dupe-list")!;
  const description = document.getElementById(
    "description",
  ) as HTMLInputElement;

  let dupeTimer: number | undefined;
  const checkDupes = () => {
    window.clearTimeout(dupeTimer);
    dupeTimer = window.setTimeout(async () => {
      if (title.value.trim().length < 3) {
        dupeWarn.hidden = true;
        return;
      }
      const res = await fetch("/api/similar", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          title: title.value,
          description: description?.value ?? "",
        }),
      });
      const { matches } = await res.json();
      if (!matches?.length) {
        dupeWarn.hidden = true;
        return;
      }
      dupeList.innerHTML = matches
        .map(
          (m: any) =>
            `<li><a href="${m.href}" target="_blank" rel="noopener">${m.title}</a>` +
            ` <span style="opacity:.6">${Math.round(m.score * 100)}% similar</span></li>`,
        )
        .join("");
      dupeWarn.hidden = false;
    }, 450);
  };
  title.addEventListener("input", checkDupes);
  description?.addEventListener("input", checkDupes);
  if (title.value.trim()) checkDupes();

  /* ---- paste tracking (an AI-review signal, not a gate) ------------- */
  const pasteField = document.getElementById("paste-ratio") as HTMLInputElement;
  let pastedChars = 0;
  body.addEventListener("paste", (e) => {
    pastedChars +=
      (e as ClipboardEvent).clipboardData?.getData("text")?.length ?? 0;
  });
  const syncPaste = () => {
    const len = body.value.length;
    pasteField.value = len ? String(Math.min(1, pastedChars / len)) : "0";
  };
  body.addEventListener("input", syncPaste);

  /* ---- image upload ------------------------------------------------- */
  const imageInput = document.getElementById("image-input") as HTMLInputElement;
  const uploadMsg = document.getElementById("upload-msg")!;

  async function upload(file: File) {
    uploadMsg.removeAttribute("data-kind");
    uploadMsg.textContent = `Uploading ${file.name}…`;

    const fd = new FormData();
    fd.append("file", file);
    const sid = form.querySelector<HTMLInputElement>(
      'input[name="submission_id"]',
    );
    const tok = form.querySelector<HTMLInputElement>('input[name="token"]');
    if (sid) fd.append("submission_id", sid.value);
    if (tok) fd.append("token", tok.value);

    const res = await fetch("/api/images", { method: "POST", body: fd });
    const data = await res.json().catch(() => ({ error: "Upload failed." }));

    if (!res.ok || !data.ok) {
      uploadMsg.textContent = data.error ?? "Upload failed.";
      uploadMsg.setAttribute("data-kind", "error");
      return;
    }

    const snippet = `

![${file.name.replace(/\.[^.]+$/, "")}](${data.url})

`;
    const at = body.selectionStart ?? body.value.length;
    body.value = body.value.slice(0, at) + snippet + body.value.slice(at);
    body.dispatchEvent(new Event("input", { bubbles: true }));
    uploadMsg.textContent = `Inserted ${data.width ?? "?"}×${data.height ?? "?"}`;
  }

  imageInput.addEventListener("change", () => {
    const f = imageInput.files?.[0];
    if (f) upload(f);
    imageInput.value = "";
  });

  // drag an image straight onto the textarea
  body.addEventListener("dragover", (e) => e.preventDefault());
  body.addEventListener("drop", (e) => {
    const f = (e as DragEvent).dataTransfer?.files?.[0];
    if (f && f.type.startsWith("image/")) {
      e.preventDefault();
      upload(f);
    }
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    syncPaste();
    btn.disabled = true;
    msg.textContent = "Sending…";
    msg.removeAttribute("data-kind");

    const res = await fetch(action, {
      method: "POST",
      body: new FormData(form),
    });
    const data = await res
      .json()
      .catch(() => ({ error: "Something went wrong." }));

    if (res.ok && data.ok) {
      if (data.redirect) {
        window.location.href = data.redirect;
        return;
      }
      form.hidden = true;
      msg.textContent = "";
      out.insertAdjacentHTML(
        "beforebegin",
        `<div class="notebox" style="--note-color: var(--green)">
           <div class="notebox-header"><span class="notebox-title">Submitted</span></div>
           <div class="notebox-body">
             ${data.message ?? "Thanks — an editor will review this."}
             ${
               data.resumeUrl
                 ? `<p style="margin-top:.6rem">Keep this link to check on it or make changes:
                      <br/><code>${location.origin}${data.resumeUrl}</code></p>`
                 : ""
             }
           </div>
         </div>`,
      );
    } else {
      msg.textContent = data.error ?? "Something went wrong.";
      msg.setAttribute("data-kind", "error");
      btn.disabled = false;
    }
  });
</script>
