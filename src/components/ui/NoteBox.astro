---
export type NoteType = "note" | "warning" | "tip" | "danger";

export interface Props {
  type?: NoteType;
  title?: string;
}

const { type = "note", title } = Astro.props;

const config: Record<NoteType, { icon: string; label: string; color: string }> =
  {
    note: { icon: "ℹ️", label: "Note", color: "var(--blue)" },
    warning: { icon: "⚠️", label: "Warning", color: "var(--yellow)" },
    tip: { icon: "💡", label: "Tip", color: "var(--green)" },
    danger: { icon: "🚨", label: "Danger", color: "var(--red)" },
  };

const { icon, label, color } = config[type];
const displayTitle = title || label;
---

<aside
  class={`notebox notebox--${type}`}
  role="note"
  style={`--note-color: ${color}`}
>
  <div class="notebox-header">
    <span class="notebox-icon" aria-hidden="true">{icon}</span>
    <span class="notebox-title">{displayTitle}</span>
  </div>
  <div class="notebox-body">
    <slot />
  </div>
</aside>

<style>
  .notebox {
    border: 1px solid color-mix(in srgb, var(--note-color) 35%, transparent);
    background: color-mix(in srgb, var(--note-color) 11%, transparent);
    border-radius: var(--radius-md);
    padding: 0.875rem 1.25rem;
    margin: 1.5rem 0;
  }

  .notebox-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .notebox-icon {
    font-size: 1rem;
  }

  .notebox-title {
    font-weight: 800;
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--note-color);
  }

  .notebox-body {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .notebox-body :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
