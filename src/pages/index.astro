---
export const prerender = true;
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import WikiLayout from "../components/layout/WikiLayout.astro";
import { getCategories, categorySlug } from "../lib/getCategories";
import { getRecentChanges } from "../lib/getRecentChanges";
import Blueprint from "../components/layout/Blueprint.astro";
import RainbowWord from "../components/ui/RainbowWord.astro";

const allPages = await getCollection("wiki");
const featured = allPages.filter((p) => p.data.featured);
const categories = getCategories(allPages);
const sortedCats = Object.keys(categories).sort();
const recentChanges = getRecentChanges(5);

// Category icons for the browse section
const catIcons: Record<string, string> = {
  clubs: `<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>`,
  community: `<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>`,
  events: `<rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>`,
  "getting-started": `<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/>`,
  hardware: `<rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="14" x2="23" y2="14"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="14" x2="4" y2="14"/>`,
  meta: `<circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>`,
  projects: `<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>`,
  tools: `<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>`,
};

function getCatIcon(cat: string): string {
  const key = cat.toLowerCase().replace(/\s+/g, "-");
  return catIcons[key] ?? `<path d="M3 7h18M3 12h18M3 17h12"/>`;
}
---

<Base
  title="Hack Club Wiki"
  description="The community-maintained knowledge base for Hack Club — clubs, events, projects, and culture."
>
  <WikiLayout showToc={false}>
    <!-- Hero -->
    <section class="hero">
      <Blueprint />

      <!-- Placeholder fills — swap for real club photos: <img src="…" alt="" /> -->
      <div class="polaroid polaroid--1" aria-hidden="true"><span></span></div>
      <div class="polaroid polaroid--2" aria-hidden="true"><span></span></div>
      <div class="polaroid polaroid--3" aria-hidden="true"><span></span></div>
      <div class="polaroid polaroid--4" aria-hidden="true"><span></span></div>

      <div class="hero-content">
        <h1 class="hero-title">
          Where <RainbowWord word="hackers" /> write it down.
        </h1>

        <p class="hero-desc">
          The community-maintained knowledge base for Hack Club — clubs,
          hackathons, hardware, and the people who make it happen. Anyone can
          edit.
        </p>

        <form
          class="hero-search"
          action="/special/search"
          method="get"
          role="search"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.35-4.35"></path>
          </svg>
          <input
            id="hero-q"
            name="q"
            type="search"
            placeholder="How do I start a club?"
            aria-label="Search the wiki"
          />
          <button type="submit">Search</button>
        </form>

        <p class="hero-micro">
          {allPages.length} pages, all of them editable. Start with <a
            href="/wiki/getting-started">Getting Started</a
          >.
        </p>
      </div>
    </section>

    <!-- Quick stats bar -->
    <div class="stats-bar">
      <a
        href="/special/all-pages"
        class="stat"
        aria-label="{allPages.length} articles"
      >
        <div class="stat-icon">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
            ></path>
            <polyline points="14 2 14 8 20 8"></polyline>
          </svg>
        </div>
        <span class="stat-n">{allPages.length}</span>
        <span class="stat-label">Articles</span>
      </a>
      <div class="stat-divider" aria-hidden="true"></div>
      <a
        href="/special/categories"
        class="stat"
        aria-label="{sortedCats.length} categories"
      >
        <div class="stat-icon">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="3" y="3" width="7" height="7"></rect><rect
              x="14"
              y="3"
              width="7"
              height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect><rect
              x="3"
              y="14"
              width="7"
              height="7"></rect>
          </svg>
        </div>
        <span class="stat-n">{sortedCats.length}</span>
        <span class="stat-label">Categories</span>
      </a>
      <div class="stat-divider" aria-hidden="true"></div>
      <a
        href="https://hackclub.com/clubs"
        class="stat"
        target="_blank"
        rel="noopener"
        aria-label="600+ clubs worldwide"
      >
        <div class="stat-icon">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path
              d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
            ></path>
          </svg>
        </div>
        <span class="stat-n">600+</span>
        <span class="stat-label">Clubs worldwide</span>
      </a>
      <div class="stat-divider" aria-hidden="true"></div>
      <a
        href="https://hackclub.com/slack"
        class="stat"
        target="_blank"
        rel="noopener"
        aria-label="50k+ members"
      >
        <div class="stat-icon">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
        </div>
        <span class="stat-n">50k+</span>
        <span class="stat-label">Members</span>
      </a>
    </div>

    <!-- Featured Articles -->
    {
      featured.length > 0 && (
        <section class="home-section">
          <div class="section-header">
            <h2 class="section-title">Featured Articles</h2>
            <a href="/special/all-pages" class="section-more">
              All pages
              <svg
                width="13"
                height="13"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="12 5 19 12 12 19" />
              </svg>
            </a>
          </div>
          <div class="featured-grid">
            {featured.map((page) => (
              <a href={`/wiki/${page.id}`} class="featured-card">
                <div class="featured-card-top">
                  <div class="featured-card-cats">
                    {page.data.categories.slice(0, 2).map((c: string) => (
                      <span class="featured-cat">{c}</span>
                    ))}
                  </div>
                  <div class="featured-card-arrow" aria-hidden="true">
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <line x1="5" y1="12" x2="19" y2="12" />
                      <polyline points="12 5 19 12 12 19" />
                    </svg>
                  </div>
                </div>
                <h3 class="featured-card-title">{page.data.title}</h3>
                <p class="featured-card-desc">{page.data.description}</p>
                <span class="featured-read">
                  Read article
                  <svg
                    width="12"
                    height="12"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <line x1="5" y1="12" x2="19" y2="12" />
                    <polyline points="12 5 19 12 12 19" />
                  </svg>
                </span>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <!-- Browse by Category -->
    <section class="home-section">
      <div class="section-header">
        <h2 class="section-title">Browse by Category</h2>
        <a href="/special/categories" class="section-more">
          All categories
          <svg
            width="13"
            height="13"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
      <div class="cat-tags">
        {
          sortedCats.map((cat) => {
            const icon = getCatIcon(cat);
            return (
              <a href={`/category/${categorySlug(cat)}`} class="cat-tag">
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={icon}
                />
                {cat}
                <span class="cat-tag-count">{categories[cat].length}</span>
              </a>
            );
          })
        }
      </div>
    </section>

    <!-- Recent Changes -->
    <section class="home-section">
      <div class="section-header">
        <h2 class="section-title">Recent Changes</h2>
        <a href="/special/recent-changes" class="section-more">
          View all
          <svg
            width="13"
            height="13"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>

      {
        recentChanges.length === 0 ? (
          <div class="recent-empty">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="10" />
              <line x1="12" y1="8" x2="12" y2="12" />
              <line x1="12" y1="16" x2="12.01" y2="16" />
            </svg>
            <p>
              Recent changes will appear here once wiki articles have been
              committed to git.
            </p>
          </div>
        ) : (
          <ul class="recent-list" role="list">
            {recentChanges.map((change) => (
              <li class="recent-item">
                <div class="recent-meta">
                  <span class="recent-author">{change.author}</span>
                  <span class="recent-sep" aria-hidden="true">
                    ·
                  </span>
                  <time class="recent-time" datetime={change.date}>
                    {change.relativeDate}
                  </time>
                </div>
                <p class="recent-msg">{change.message}</p>
                {change.files.length > 0 && (
                  <div class="recent-files">
                    {change.files.slice(0, 3).map((f: string) => (
                      <a href={`/wiki/${f}`} class="recent-file">
                        {f}
                      </a>
                    ))}
                  </div>
                )}
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </WikiLayout>
</Base>

<style>
  /* ---- Hero ---- */
  .hero {
    position: relative;
    overflow: hidden;
    /* full-bleed out of .wiki-article's padding */
    margin: -2rem -2.5rem 0;
    padding: 4.5rem 2rem 5rem;
    background: var(--hero-grad);
    color: #f9f0e4;
    display: flex;
    justify-content: center;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.1rem;
    width: 100%;
  }

  .hero-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.4rem, 6.5vw, 4.4rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-wrap: balance;
    max-width: 16ch;
    margin: 0;
  }

  .hero-desc {
    font-size: 1.0625rem;
    line-height: 1.55;
    color: rgba(249, 240, 228, 0.82);
    max-width: 46ch;
    margin: 0;
  }

  /* search pill — hackclub.com's email capture, repurposed */
  .hero-search {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: min(460px, 100%);
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(249, 240, 228, 0.16);
    border-radius: 999px;
    padding: 0.35rem 0.35rem 0.35rem 1.1rem;
    margin-top: 0.25rem;
    color: rgba(249, 240, 228, 0.45);
  }

  .hero-search input {
    flex: 1;
    min-width: 0;
    background: none;
    border: 0;
    outline: none;
    font: inherit;
    font-size: 0.95rem;
    color: #f9f0e4;
  }

  .hero-search input::placeholder {
    color: rgba(249, 240, 228, 0.45);
  }

  .hero-search button {
    border: 0;
    cursor: pointer;
    border-radius: 999px;
    background: #f9f0e4;
    color: #2a0f13;
    font: inherit;
    font-weight: 700;
    font-size: 0.875rem;
    padding: 0.6rem 1.35rem;
    white-space: nowrap;
    transition: background var(--transition-fast);
  }

  .hero-search button:hover {
    background: #fff;
  }

  .hero-micro {
    font-size: 0.8125rem;
    color: rgba(249, 240, 228, 0.62);
    background: rgba(0, 0, 0, 0.26);
    border-radius: 999px;
    padding: 0.3rem 1rem;
    margin: 0;
  }

  .hero-micro a {
    color: #f9f0e4;
    text-underline-offset: 2px;
  }

  /* ---- Polaroids ---- */
  .polaroid {
    position: absolute;
    z-index: 1;
    background: #f9f0e4;
    padding: 6px 6px 17px;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.35);
  }

  .polaroid > span,
  .polaroid img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
    border-radius: 0;
    margin: 0;
  }

  /* placeholder fills — delete once real photos are in */
  .polaroid--1 > span {
    background: linear-gradient(140deg, #ec3750, #ff8c37);
  }
  .polaroid--2 > span {
    background: linear-gradient(140deg, #338eda, #33d6a6);
  }
  .polaroid--3 > span {
    background: linear-gradient(140deg, #a633d6, #338eda);
  }
  .polaroid--4 > span {
    background: linear-gradient(140deg, #f1c40f, #ff8c37);
  }

  .polaroid--1 {
    left: 2.5%;
    top: 14%;
    width: 104px;
    height: 104px;
    transform: rotate(-7deg);
  }
  .polaroid--2 {
    left: 5%;
    bottom: 9%;
    width: 84px;
    height: 84px;
    transform: rotate(6deg);
  }
  .polaroid--3 {
    right: 3%;
    top: 10%;
    width: 96px;
    height: 96px;
    transform: rotate(8deg);
  }
  .polaroid--4 {
    right: 6%;
    bottom: 11%;
    width: 78px;
    height: 78px;
    transform: rotate(-9deg);
  }

  /* These negative margins track .wiki-article's padding in WikiLayout.astro.
     If that padding changes, change these too. */
  @media (max-width: 64em) {
    .hero {
      margin: -1.5rem -1.75rem 0;
      padding: 3rem 1.5rem 3.5rem;
    }
    .polaroid {
      display: none;
    }
  }

  @media (max-width: 48em) {
    .hero {
      margin: -1.25rem -1rem 0;
      padding: 2.5rem 1.25rem 3rem;
    }
  }

  /* ---- Stats bar ---- */
  .stats-bar {
    display: flex;
    align-items: stretch;
    background: var(--elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    margin-bottom: 3rem;
    overflow: hidden;
  }

  .stat {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1.25rem 0.75rem;
    gap: 0.3rem;
    text-decoration: none;
    color: var(--text);
    transition: background var(--transition-fast);
    cursor: pointer;
  }

  .stat:hover {
    background: var(--elevated-2);
  }

  .stat-icon {
    color: var(--muted);
    margin-bottom: 0.2rem;
    transition: color var(--transition-fast);
  }

  .stat:hover .stat-icon {
    color: var(--red);
  }

  .stat-n {
    font-size: 1.625rem;
    font-weight: 900;
    color: var(--red);
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    font-size: 0.6875rem;
    color: var(--muted);
    text-align: center;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .stat-divider {
    width: 1px;
    background: var(--border);
    flex-shrink: 0;
    margin: 0.75rem 0;
  }

  /* ---- Sections ---- */
  .home-section {
    margin-bottom: 3rem;
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .section-title {
    font-size: 1.125rem;
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  .section-more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8125rem;
    color: var(--red);
    text-decoration: none;
    font-weight: 600;
    transition:
      gap var(--transition-fast),
      color var(--transition-fast);
  }

  .section-more:hover {
    gap: 0.55rem;
    color: var(--red);
  }

  /* ---- Featured grid ---- */
  .featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 0.875rem;
  }

  .featured-card {
    display: flex;
    flex-direction: column;
    background: var(--elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
    text-decoration: none;
    color: var(--text);
    transition:
      border-color var(--transition-base),
      box-shadow var(--transition-base),
      transform var(--transition-base);
    cursor: pointer;
    position: relative;
    overflow: hidden;
  }

  .featured-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--red), transparent);
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  .featured-card:hover {
    border-color: var(--border-hover);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.3),
      0 0 0 1px rgba(236, 55, 80, 0.08);
    transform: translateY(-2px);
  }

  .featured-card:hover::before {
    opacity: 1;
  }

  .featured-card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .featured-card-cats {
    display: flex;
    gap: 0.375rem;
    flex-wrap: wrap;
  }

  .featured-cat {
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    background: var(--elevated-2);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.15rem 0.45rem;
  }

  .featured-card-arrow {
    color: var(--muted);
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity var(--transition-base),
      transform var(--transition-base),
      color var(--transition-base);
    flex-shrink: 0;
