---
export const prerender = false;
import Base from "../../layouts/Base.astro";
import { getSubmission, listEvents } from "../../lib/db";
import { renderArticle } from "../../lib/markdown";
import { findSimilar } from "../../lib/similarity";
import { candidates } from "../api/similar";
import type { Signal } from "../../lib/aiSignals";

const id = Number(Astro.params.id);
const row = Number.isInteger(id) ? await getSubmission(id) : null;
if (!row) return new Response(null, { status: 404 });

const events = await listEvents(id);
const { html } = renderArticle(row.body);
const error = Astro.url.searchParams.get("error");
const resumeUrl = row.edit_token
  ? `/contribute/${row.id}?token=${row.edit_token}`
  : null;

const signals = (row.ai_signals as Signal[] | null) ?? [];
const aiScore = row.ai_score;
const band =
  aiScore == null
    ? null
    : aiScore >= 65
      ? "high"
      : aiScore >= 40
        ? "medium"
        : "low";

// Exclude this page's own slug so it never matches itself.
const dupes = findSimilar(
  row.title,
  row.description,
  (await candidates()).filter((c) => c.slug !== row.slug),
);
---

<Base title={`Review — ${row.title}`} noindex>
  <main class="admin">
    <a href="/admin" class="back">← Back to queue</a>

    {error && <p class="err">{error}</p>}

    <p class="submitted">
      Submitted by <strong>{row.author_name || "anonymous"}</strong>
      {row.author_contact && <> · {row.author_contact}</>}
      · {new Date(row.created_at).toLocaleString()} · status <strong
        >{row.status.replace(/_/g, " ")}</strong
      >
    </p>

    {
      row.revision > 1 && (
        <p class="revision">
          Revision {row.revision} — the author has already reworked this.
        </p>
      )
    }

    {
      events.length > 0 && (
        <ol class="history">
          {events.map((e) => (
            <li>
              <strong>{e.action.replace(/_/g, " ")}</strong>
              <span>{e.actor}</span>
              <time>{new Date(e.created_at).toLocaleString()}</time>
              {e.note && <p>{e.note}</p>}
            </li>
          ))}
        </ol>
      )
    }

    {
      dupes.length > 0 && (
        <div class="panel panel--dupe">
          <h2>Possible duplicates</h2>
          <ul>
            {dupes.map((d) => (
              <li>
                <a href={d.href} target="_blank" rel="noopener">
                  {d.title}
                </a>
                <span>{Math.round(d.score * 100)}% similar</span>
                <em>{d.source === "page" ? "markdown page" : "community"}</em>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      aiScore != null && (
        <div class:list={["panel", "panel--ai", `ai--${band}`]}>
          <h2>
            Authorship signals — <strong>{aiScore}/100</strong> ({band} concern)
          </h2>
          <p class="disclaimer">
            These are heuristics, not proof. AI detection is unreliable and
            misfires most often on people writing in a second language. Read the
            evidence and judge the page — never reject on this score alone.
          </p>
          <ul>
            {signals.map((sig) => (
              <li>
                <span
                  class="bar"
                  style={`--v:${Math.round(sig.score * 100)}%`}
                  aria-hidden="true"
                />
                <strong>{sig.label}</strong>
                <span class="detail">{sig.detail}</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <form method="post" action="/api/admin/review" class="review">
      <input type="hidden" name="id" value={row.id} />

      <label for="title">Title</label>
      <input id="title" name="title" value={row.title} />

      <label for="slug">Slug</label>
      <input id="slug" name="slug" value={row.slug} />

      <label for="body">Body — edit before approving if it needs a fix</label>
      <textarea id="body" name="body" rows="20">{row.body}</textarea>

      <label for="review_note">
        Message to the author — required to request changes, and they will see
        it
      </label>
      <textarea id="review_note" name="review_note" rows="3"
        >{row.review_note}</textarea
      >

      <label for="admin_note">Internal note</label>
      <input
        id="admin_note"
        name="admin_note"
        value={row.admin_note}
        placeholder="Only editors see this"
      />

      <div class="verdict">
        <button type="submit" name="action" value="approve" class="approve">
          Approve &amp; publish
        </button>
        <button
          type="submit"
          name="action"
          value="request_changes"
          class="changes"
        >
          Request changes
        </button>
        <button type="submit" name="action" value="reject" class="reject">
          Reject
        </button>
      </div>
    </form>

    {
      resumeUrl && (
        <p class="resume">
          Author's link — send this to them if you requested changes:
          <code>
            {Astro.url.origin}
            {resumeUrl}
          </code>
        </p>
      )
    }

    <section class="rendered">
      <h2>Rendered</h2>
      <article class="wiki-prose" set:html={html} />
    </section>
  </main>
</Base>

<style>
  .admin {
    max-width: 860px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
  }
  .back {
    font-size: 0.85rem;
    color: var(--muted);
    text-decoration: none;
  }
  .err {
    color: var(--red);
    font-size: 0.9rem;
    margin: 1rem 0;
  }
  .submitted {
    font-size: 0.85rem;
    color: var(--muted);
    margin: 1rem 0 0.5rem;
  }
  .revision {
    font-size: 0.85rem;
    color: var(--orange);
    margin-bottom: 1rem;
  }

  .history {
    list-style: none;
    margin: 0 0 1.75rem;
    padding: 0 0 0 1rem;
    border-left: 2px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .history li {
    font-size: 0.82rem;
    color: var(--muted);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: baseline;
  }
  .history strong {
    color: var(--text);
    text-transform: capitalize;
  }
  .history p {
    flex-basis: 100%;
    color: var(--text-secondary);
    margin: 0.15rem 0 0;
  }

  .panel {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 0.9rem 1.1rem;
    margin-bottom: 1.25rem;
    background: var(--elevated);
  }
  .panel h2 {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.6rem;
  }
  .panel ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .panel--dupe {
    background: color-mix(in srgb, var(--yellow) 10%, transparent);
    border-color: color-mix(in srgb, var(--yellow) 35%, transparent);
  }
  .panel--dupe li {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    flex-wrap: wrap;
    font-size: 0.875rem;
  }
  .panel--dupe span {
    color: var(--muted);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
  }
  .panel--dupe em {
    font-style: normal;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .ai--medium {
    border-color: color-mix(in srgb, var(--orange) 40%, transparent);
  }
  .ai--high {
    border-color: color-mix(in srgb, var(--red) 45%, transparent);
    background: color-mix(in srgb, var(--red) 8%, transparent);
  }
  .disclaimer {
    font-size: 0.78rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 0.8rem;
    max-width: 62ch;
  }
  .panel--ai li {
    display: grid;
    grid-template-columns: 46px 1fr;
    gap: 0.25rem 0.7rem;
    align-items: center;
    font-size: 0.85rem;
  }
  .panel--ai .bar {
    grid-row: span 2;
    height: 6px;
    border-radius: 3px;
    background: var(--border);
    position: relative;
    overflow: hidden;
  }
  .panel--ai .bar::after {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--v);
    background: var(--red);
  }
  .panel--ai .detail {
    grid-column: 2;
    font-size: 0.78rem;
    color: var(--muted);
  }

  .review {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .review label {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 0.8rem;
  }
  .review input,
  .review textarea {
    font: inherit;
    background: var(--elevated);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 0.6rem 0.8rem;
  }
  .review textarea {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.7;
    resize: vertical;
  }

  .verdict {
    display: flex;
    gap: 0.6rem;
    margin-top: 1.25rem;
    flex-wrap: wrap;
  }
  .verdict button {
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    border: 0;
    border-radius: 999px;
    padding: 0.65rem 1.4rem;
  }
  .approve {
    background: var(--green);
    color: #10231d;
  }
  .changes {
    background: var(--yellow);
    color: #2a1f03;
  }
  .reject {
    background: transparent;
    color: var(--red);
    border: 1.5px solid var(--red);
  }

  .resume {
    margin-top: 1.25rem;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .resume code {
    display: block;
    margin-top: 0.3rem;
    font-family: var(--font-mono);
    color: var(--red);
    word-break: break-all;
  }

  .rendered {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .rendered h2 {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1rem;
  }
</style>
