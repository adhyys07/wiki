---
export const prerender = false;
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import WikiLayout from "../components/layout/WikiLayout.astro";
import Breadcrumb from "../components/layout/Breadcrumb.astro";
import PageEditor from "../components/submit/PageEditor.astro";
import { getCategories } from "../lib/getCategories";

const allPages = await getCollection("wiki");
const categoryNames = Object.keys(getCategories(allPages)).sort();
---

<Base
  title="Write a page"
  description="Submit a new page to the Hack Club Wiki."
>
  <WikiLayout showToc={false}>
    <Breadcrumb crumbs={[{ label: "Write a page" }]} />

    <header class="contribute-head">
      <h1>Write a page</h1>
      <p>
        Anyone can write for the wiki. Draft it here, check the preview, and
        send it in — an editor reads every submission before it goes live.
      </p>
    </header>

    <PageEditor
      action="/api/submissions"
      submitLabel="Send for review"
      categoryNames={categoryNames}
    />
  </WikiLayout>
</Base>

<style>
  .contribute-head {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }
  .contribute-head h1 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 2.75rem;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }
  .contribute-head p {
    color: var(--text-secondary);
    max-width: 58ch;
  }
</style>
