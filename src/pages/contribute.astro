---
export const prerender = false;
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import WikiLayout from "../components/layout/WikiLayout.astro";
import Breadcrumb from "../components/layout/Breadcrumb.astro";
import { getCategories } from "../lib/getCategories";

const allPages = await getCollection("wiki");
const categoryNames = Object.keys(getCategories(allPages)).sort();
---

<Base
  title="Write a page"
  description="Submit a new page to the Hack Club Wiki."
>
  <WikiLayout showToc={false}>
    <Breadcrumb crumbs={[{ label: "Write a page" }]} />

    <header class="contribute-head">
      <h1>Write a page</h1>
      <p>
        Anyone can write for the wiki. Draft it here, check the preview, and
        send it in — an editor reads every submission before it goes live.
      </p>
    </header>

    <form id="submit-form" class="cform">
      <p class="cfield cfield--hp" aria-hidden="true">
        <label for="website">Leave this empty</label>
        <input
          id="website"
          name="website"
          type="text"
          tabindex="-1"
          autocomplete="off"
        />
      </p>

      <div class="cfield">
        <label for="title">Page title</label>
        <input
          id="title"
          name="title"
          type="text"
          required
          maxlength="120"
          placeholder="Running a Hackathon"
        />
        <small>URL: <code id="slug-preview">/wiki/c/…</code></small>
      </div>

      <div class="cfield">
        <label for="description">One-line description</label>
        <input
          id="description"
          name="description"
          type="text"
          maxlength="300"
          placeholder="What this page covers, in a sentence."
        />
      </div>

      <div class="crow">
        <div class="cfield">
          <label for="categories">Categories</label>
          <input
            id="categories"
            name="categories"
            type="text"
            list="cat-list"
            placeholder="Events, Clubs"
          />
          <datalist id="cat-list">
            {categoryNames.map((c) => <option value={c} />)}
          </datalist>
          <small>Comma-separated.</small>
        </div>
        <div class="cfield">
          <label for="tags">Tags</label>
          <input
            id="tags"
            name="tags"
            type="text"
            placeholder="hackathon, funding"
          />
          <small>Comma-separated.</small>
        </div>
      </div>

      <div class="cfield">
        <label for="body">The page</label>
        <textarea id="body" name="body" rows="18" required></textarea>
        <small>
          Markdown. <code>[[Page Name]]</code> links to another wiki page.
        </small>
      </div>

      <div class="crow">
        <div class="cfield">
          <label for="author_name">Your name</label>
          <input
            id="author_name"
            name="author_name"
            type="text"
            maxlength="80"
            placeholder="So we can credit you"
          />
        </div>
        <div class="cfield">
          <label for="author_contact">Slack handle or email</label>
          <input
            id="author_contact"
            name="author_contact"
            type="text"
            maxlength="160"
            placeholder="@you — only if you want a reply"
          />
        </div>
      </div>

      <div class="cactions">
        <button type="submit" id="submit-btn">Send for review</button>
        <span id="form-msg" role="status" aria-live="polite"></span>
      </div>
    </form>

    <section class="cpreview" aria-label="Preview">
      <h2>Preview</h2>
      <article class="wiki-prose" id="preview-out">
        <p class="cpreview-empty">Start typing and your page appears here.</p>
      </article>
    </section>
  </WikiLayout>
</Base>

<style>
  .contribute-head {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }
  .contribute-head h1 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 2.75rem;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }
  .contribute-head p {
    color: var(--text-secondary);
    max-width: 58ch;
  }

  .cform {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .crow {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
  }
  .cfield {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .cfield--hp {
    position: absolute;
    left: -9999px;
  }

  .cfield label {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .cfield small {
    font-size: 0.75rem;
    color: var(--muted);
  }
  .cfield small code {
    font-family: var(--font-mono);
    color: var(--red);
  }

  .cform input,
  .cform textarea {
    font: inherit;
    background: var(--elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 0.6rem 0.8rem;
    color: var(--text);
    width: 100%;
  }
  .cform textarea {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.7;
    resize: vertical;
  }
  .cform input:focus,
  .cform textarea:focus {
    border-color: var(--red);
    outline: none;
  }

  .cactions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .cactions button {
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    background: var(--red);
    color: #fff;
    border: 0;
    border-radius: 999px;
    padding: 0.7rem 1.6rem;
  }
  .cactions button[disabled] {
    opacity: 0.55;
    cursor: progress;
  }

  #form-msg {
    font-size: 0.875rem;
  }
  #form-msg[data-kind="error"] {
    color: var(--red);
  }

  .cpreview {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .cpreview h2 {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1rem;
  }
  .cpreview-empty {
    color: var(--muted);
    font-style: italic;
  }
</style>

<script>
  const form = document.getElementById("submit-form") as HTMLFormElement;
  const title = document.getElementById("title") as HTMLInputElement;
  const body = document.getElementById("body") as HTMLTextAreaElement;
  const slugOut = document.getElementById("slug-preview")!;
  const out = document.getElementById("preview-out")!;
  const msg = document.getElementById("form-msg")!;
  const btn = document.getElementById("submit-btn") as HTMLButtonElement;

  body.placeholder =
    "# Heading\n\nMarkdown works. Link other pages with [[Sprig]].";

  const slugify = (s: string) =>
    s
      .toLowerCase()
      .trim()
      .replace(/[^a-z0-9\s-]/g, "")
      .replace(/\s+/g, "-")
      .replace(/-+/g, "-")
      .replace(/^-|-$/g, "")
      .slice(0, 80);

  title.addEventListener("input", () => {
    slugOut.textContent = `/wiki/c/${slugify(title.value) || "…"}`;
  });

  // Preview goes through the server so it matches what publishes exactly.
  let timer: number | undefined;
  body.addEventListener("input", () => {
    window.clearTimeout(timer);
    timer = window.setTimeout(async () => {
      if (!body.value.trim()) {
        out.innerHTML =
          '<p class="cpreview-empty">Start typing and your page appears here.</p>';
        return;
      }
      const res = await fetch("/api/preview", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ body: body.value }),
      });
      const { html } = await res.json();
      out.innerHTML = html;
    }, 350);
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    btn.disabled = true;
    msg.textContent = "Sending…";
    msg.removeAttribute("data-kind");

    const res = await fetch("/api/submissions", {
      method: "POST",
      body: new FormData(form),
    });
    const data = await res
      .json()
      .catch(() => ({ error: "Something went wrong." }));

    if (res.ok && data.ok) {
      form.hidden = true;
      msg.textContent = "";
      out.insertAdjacentHTML(
        "beforebegin",
        `<div class="notebox" style="--note-color: var(--green)">
           <div class="notebox-header"><span class="notebox-title">Submitted</span></div>
           <div class="notebox-body">
             Thanks — an editor will review this and it will appear at
             <code>/wiki/c/${data.slug}</code> once approved.
           </div>
         </div>`,
      );
    } else {
      msg.textContent = data.error ?? "Something went wrong.";
      msg.setAttribute("data-kind", "error");
      btn.disabled = false;
    }
  });
</script>
