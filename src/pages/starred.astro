---
// Server-rendered: stars change at review time, with no rebuild in between.
export const prerender = false;

import Base from "../layouts/Base.astro";
import WikiLayout from "../components/layout/WikiLayout.astro";
import Breadcrumb from "../components/layout/Breadcrumb.astro";
import { listStarred, type Submission } from "../lib/db";

let picks: Submission[] = [];
let dbDown = false;
try {
  picks = await listStarred();
} catch {
  dbDown = true;
}
---

<Base
  title="Editors' picks"
  description="Community-written pages the editors thought were especially good."
>
  <WikiLayout showToc={false}>
    <Breadcrumb crumbs={[{ label: "Editors' picks" }]} />

    <header class="picks-head">
      <h1>Editors' picks</h1>
      <p>
        Pages written by the community that an editor thought were especially
        good — clear, specific, and actually useful to the next person.
      </p>
    </header>

    {
      dbDown ? (
        <p class="empty">Picks are unavailable right now.</p>
      ) : picks.length === 0 ? (
        <p class="empty">
          Nothing starred yet. <a href="/contribute">Write something</a> and it
          might end up here.
        </p>
      ) : (
        <ul class="picks" role="list">
          {picks.map((p) => (
            <li>
              <a href={`/wiki/c/${p.slug}`}>
                <span class="star" aria-hidden="true">
                  ★
                </span>
                <span class="body">
                  <strong>{p.title}</strong>
                  {p.description && <span class="desc">{p.description}</span>}
                  <span class="by">
                    by {p.author_name || "an anonymous Hack Clubber"}
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </WikiLayout>
</Base>

<style>
  .picks-head {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }
  .picks-head h1 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 2.75rem;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }
  .picks-head p {
    color: var(--text-secondary);
    max-width: 58ch;
  }

  .picks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .picks a {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    text-decoration: none;
    color: inherit;
    background: var(--elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1rem 1.15rem;
    transition: border-color var(--transition-fast);
  }
  .picks a:hover {
    border-color: var(--yellow);
  }
  .star {
    color: var(--yellow);
    font-size: 1.1rem;
    line-height: 1.3;
  }
  .picks .body {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }
  .picks strong {
    font-size: 1.0625rem;
    font-weight: 700;
  }
  .desc {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .by {
    font-size: 0.78rem;
    color: var(--muted);
  }
  .empty {
    color: var(--muted);
    font-style: italic;
  }
</style>
